<!DOCTYPE html>
<html lang="en">
  <%- include("./partials/head.ejs")%>
  <body>
    <header>
      <a href="/">
        <h1>Mini Messageboard</h1>
      </a>
      <a class="create-msg btn-link" href="/new">New Message</a>
    </header>

    <h2 class="title">Messages</h2>
    <% if(messages){%>

    <ul>
      <% messages.map(msg => {%>

      <li class="message">
        <a href="/message/<%= msg.user%>">
          <h3>Sender: <%= msg.user %></h3>
          <!-- <p><%= msg.text %></p> -->
          <small><%= msg.added %></small>
        </a>
      </li>

      <%})%>
    </ul>

    <%}%>
  </body>
</html>
